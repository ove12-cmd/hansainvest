# Prisma Postgres direct connection string (console.prisma.io → your project → Connect)
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# Admin login (single hardcoded admin — used by prisma/seed.ts)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# Encrypted session cookie secret — must be at least 32 characters
SESSION_SECRET="generate-a-long-random-string-here"

# Resend (https://resend.com) — needed for the Kontakt form to actually deliver leads.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="you@example.com"
